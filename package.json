{
  "name": "sklum-app-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "stubs": "npm run dev --workspace @sklum/stubs",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "bff": "npm run dev --workspace @sklum/bff",
    "mobile": "npm run start --workspace @sklum/mobile"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
